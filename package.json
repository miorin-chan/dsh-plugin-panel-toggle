{
  "name": "@miorin/dsh-plugin-panel-toggle",
  "version": "0.1.1",
  "license": "MIT",
  "description": "Adds a Mod+Shift+, shortcut that switches to the Plugins panel and back to the page you left.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "DESIGN.md",
    "AGENTS.md",
    "AGENTS.local.md",
    "docs/README.md",
    "docs/DETAIL.md",
    "docs/DETAIL.zh.md",
    "docs/assets/screenshots/main-dark.png",
    "docs/assets/screenshots/main-light.png",
    "src",
    "scripts",
    "tsconfig.json",
    "tsconfig.tools.json"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-shortcuts",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "scripts": {
    "build": "npm run build:tools && node scripts/build.mjs",
    "prepare": "npm run build 1>&2",
    "test": "npm run build && npm run test:unit --",
    "test:unit": "node --test",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run build:tools && node scripts/build.mjs --check && npm run test:unit && npm run typecheck && node scripts/sync-types.mjs --check",
    "build:tools": "tsc -p tsconfig.tools.json"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-brand": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-shortcuts": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.5",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "typescript": "5.7.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miorin-chan/dsh-plugin-panel-toggle.git"
  },
  "homepage": "https://github.com/miorin-chan/dsh-plugin-panel-toggle#readme",
  "bugs": {
    "url": "https://github.com/miorin-chan/dsh-plugin-panel-toggle/issues"
  }
}
